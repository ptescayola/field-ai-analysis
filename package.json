{
  "name": "field-ai-analysis",
  "version": "1.0.0",
  "type": "module",
  "description": "AI agronomic copilot — field data analysis with prompt-based agents",
  "scripts": {
    "build": "tsc",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "node backend-dist/presentation/http/server.js",
    "api": "tsx backend/presentation/http/server.ts",
    "cli": "tsx backend/presentation/cli/index.ts",
    "analyze": "tsx backend/presentation/cli/index.ts",
    "app": "npm run dev --prefix app",
    "dev": "concurrently -n api,app -c green,blue \"npm run api\" \"npm run app\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@vercel/node": "^5.1.16",
    "dotenv": "^17.4.2",
    "hono": "^4.7.7",
    "openai": "^7.9.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "concurrently": "^9.1.2"
  }
}
