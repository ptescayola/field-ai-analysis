{
  "version": 2,
  "installCommand": "npm install && npm install --prefix app",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "app/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{data,agents,dist}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
